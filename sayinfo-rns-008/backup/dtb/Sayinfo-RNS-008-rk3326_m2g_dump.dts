		default-brightness-level = <0xc8>;
		enable-gpios = <0x60 0x0b 0x00>; /* gpio0 RK_PB3 */
		phandle = <0xa8>;
	};

	charge-animation {
		compatible = "rockchip,uboot-charge";
		rockchip,uboot-charge-on = <0x00>;
		rockchip,android-charge-on = <0x00>;
		rockchip,uboot-low-power-voltage = <0xd7a>;
		rockchip,screen-on-voltage = <0xd7a>;
		rockchip,uboot-exit-charge-level = <0x02>;
		rockchip,uboot-exit-charge-voltage = <0xd16>;
		status = "okay";
	};

	dummy_codec: dummy-codec {
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0xcd>;
	};

	rk809-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,rk809-codec";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,widgets = "Microphone", "Mic Jack", "Headphone", "Headphone Jack";
		simple-audio-card,routing = "Mic Jack", "MICBIAS1", "IN1P", "Mic Jack", "Headphone Jack", "HPOL", "Headphone Jack", "HPOR";

		simple-audio-card,dai-link@0 {
			format = "i2s";

			cpu {
				sound-dai = <0xca>;
			};

			codec {
				sound-dai = <0xcb 0x00>;
			};
		};

		simple-audio-card,dai-link@1 {
			format = "pdm";

			cpu {
				sound-dai = <0xcc>;
			};

			codec {
				sound-dai = <0xcd>;
			};
		};
	};

	rk_headset {
		compatible = "rockchip_headset";
		headset_gpio = <0x6b 0x04 0x01>; /* gpio3 RK_PA4 */
		pinctrl-names = "default";
		pinctrl-0 = <0xce>;
		io-channels = <0xc8 0x01>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x02 0x05>;
		clock-names = "clk_wifi_pmu";
		pinctrl-names = "default";
		pinctrl-0 = <0xcf>;
		reset-gpios = <0x60 0x02 0x01>; /* gpio0 RK_PA2 */
		phandle = <0xa1>;
	};

	vcc5v0_sys: vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x68>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "rtl8723bs";
		WIFI,host_wake_irq = <0x60 0x05 0x00>; /* gpio0 RK_PA5 */
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0xd0 0x13 0x01>; /* gpio1 RK_PC3 */
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0xd1>;
		pinctrl-1 = <0xd2>;
		BT,reset_gpio = <0x60 0x11 0x00>; /* gpio0 RK_PC1 */
		BT,wake_gpio = <0x60 0x01 0x00>; /* gpio0 RK_PA1 */
		BT,wake_host_irq = <0x60 0x07 0x00>; /* gpio0 RK_PA7 */
		status = "okay";
	};

