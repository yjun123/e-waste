	gic: interrupt-controller@ff131000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0xff131000 0x00 0x1000 0x00 0xff132000 0x00 0x2000 0x00 0xff134000 0x00 0x2000 0x00 0xff136000 0x00 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	grf: syscon@ff140000 {
		compatible = "rockchip,px30-grf", "syscon", "simple-mfd";
		reg = <0x00 0xff140000 0x00 0x1000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x30>;

		io_domains: io-domains {
			compatible = "rockchip,px30-io-voltage-domain";
			status = "okay";
			vccio1-supply = <0x4a>;
			vccio2-supply = <0x4b>;
			vccio3-supply = <0x4c>;
			vccio4-supply = <0x4a>;
			vccio5-supply = <0x4d>;
			phandle = <0xe4>;
		};

		lvds: lvds {
			compatible = "rockchip,px30-lvds";
			phys = <0x4e>;
			phy-names = "phy";
			status = "disabled";
			phandle = <0xe5>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					lvds_in_vopb: endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x13>;
						phandle = <0xab>;
					};

					lvds_in_vopl: endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x4f>;
						phandle = <0xaf>;
					};
				};
			};
		};

		rgb: rgb {
			compatible = "rockchip,px30-rgb";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x50>;
			pinctrl-1 = <0x51>;
			status = "disabled";
			phys = <0x4e>;
			phy-names = "phy";
			phandle = <0xe6>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					rgb_in_vopb: endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x15>;
						phandle = <0xad>;
					};

					rgb_in_vopl: endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x52>;
						phandle = <0xb1>;
					};
				};
			};
		};
	};

