		clock-names = "baudclk", "apb_pclk";
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		dmas = <0x2c 0x0a 0x2c 0x0b>;
		pinctrl-names = "default";
		pinctrl-0 = <0x5c 0x5d 0x5e>;
		status = "disabled";
		phandle = <0xed>;
	};

	i2c0: i2c@ff180000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xff180000 0x00 0x1000>;
		clocks = <0x02 0x1d 0x02 0x14e>;
		clock-names = "i2c", "pclk";
		interrupts = <0x00 0x07 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x5f>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0xee>;

		rk817: pmic@20 {
			compatible = "rockchip,rk817";
			reg = <0x20>;
			interrupt-parent = <0x60>;
			interrupts = <0x0a 0x08>;
			pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
			pinctrl-0 = <0x61>;
			pinctrl-1 = <0x62 0x63>;
			pinctrl-2 = <0x64 0x65>;
			pinctrl-3 = <0x66 0x67>;
			rockchip,system-power-controller;
			wakeup-source;
			#clock-cells = <0x01>;
			clock-output-names = "rk808-clkout1", "rk808-clkout2";
			pmic-reset-func = <0x01>;
			vcc1-supply = <0x68>;
			vcc2-supply = <0x68>;
			vcc3-supply = <0x68>;
			vcc4-supply = <0x68>;
			vcc5-supply = <0x69>;
			vcc6-supply = <0x69>;
			vcc7-supply = <0x69>;
			vcc8-supply = <0x69>;
			vcc9-supply = <0x68>;
			phandle = <0xef>;

			pwrkey {
				status = "okay";
			};

			pinctrl_rk8xx: pinctrl_rk8xx {
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0xf0>;

				rk817_ts_gpio1: rk817_ts_gpio1 {
					pins = "gpio_ts";
					function = "pin_fun1";
					phandle = <0xf1>;
				};

				rk817_gt_gpio2: rk817_gt_gpio2 {
					pins = "gpio_gt";
					function = "pin_fun1";
					phandle = <0xf2>;
				};

				rk817_pin_ts: rk817_pin_ts {
					pins = "gpio_ts";
					function = "pin_fun0";
					phandle = <0xf3>;
				};

				rk817_pin_gt: rk817_pin_gt {
					pins = "gpio_gt";
					function = "pin_fun0";
					phandle = <0xf4>;
				};

				rk817_slppin_null: rk817_slppin_null {
					pins = "gpio_slp";
					function = "pin_fun0";
					phandle = <0xf5>;
				};

				rk817_slppin_slp: rk817_slppin_slp {
					pins = "gpio_slp";
					function = "pin_fun1";
					phandle = <0x63>;
				};

				rk817_slppin_pwrdn: rk817_slppin_pwrdn {
					pins = "gpio_slp";
					function = "pin_fun2";
					phandle = <0x65>;
				};

				rk817_slppin_rst: rk817_slppin_rst {
					pins = "gpio_slp";
					function = "pin_fun3";
					phandle = <0x67>;
				};
			};

			regulators {

				vdd_logic: DCDC_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xe7ef0>;
					regulator-max-microvolt = <0x149970>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_logic";
					phandle = <0x0e>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xe7ef0>;
					};
				};

				vdd_arm: DCDC_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xe7ef0>;
					regulator-max-microvolt = <0x149970>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_arm";
					phandle = <0x06>;

					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0xe7ef0>;
					};
				};

				vcc_ddr: DCDC_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-initial-mode = <0x02>;
					regulator-name = "vcc_ddr";
					phandle = <0xf6>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				vcc_3v0: DCDC_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vcc_3v0";
					phandle = <0x4d>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2dc6c0>;
					};
				};

				vcc_1v0: LDO_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x2625a0>;
					regulator-max-microvolt = <0x2625a0>;
					regulator-name = "vcc_1v0";
					phandle = <0xf7>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2625a0>;
					};
				};

				vcc1v8_soc: LDO_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcc1v8_soc";
					phandle = <0x4a>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				vdd1v0_soc: LDO_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xf4240>;
					regulator-max-microvolt = <0xf4240>;
					regulator-name = "vcc1v0_soc";
					phandle = <0xf8>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xf4240>;
					};
				};

				vcc3v0_pmu: LDO_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-name = "vcc3v0_pmu";
					phandle = <0x2a>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2dc6c0>;
					};
				};

				vccio_sd: LDO_REG5 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vccio_sd";
					phandle = <0x4b>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				vcc_sd: LDO_REG6 {
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vcc_sd";
					phandle = <0x9d>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				vcc2v8_dvp: LDO_REG7 {
					regulator-boot-on;
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-name = "vcc2v8_dvp";
					phandle = <0x6f>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2ab980>;
					};
				};

				vcc1v8_dvp: LDO_REG8 {
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcc1v8_dvp";
					phandle = <0x4c>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				vdd1v8_lcd: LDO_REG9 {
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vdd1v8_lcd";
					phandle = <0x70>;

					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				vcc3v3_sys: DCDC_REG5 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vcc3v3_sys";
					phandle = <0x69>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				vcc3v3_lcd: SWITCH_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-name = "vcc3v3_lcd";
					phandle = <0xf9>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				vcc5v0_host: SWITCH_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-name = "vcc5v0_host";
					phandle = <0xfa>;
				};
			};

			battery {
				compatible = "rk817,battery";
				ocv_table = <0x1b58 0x1c52 0x1cca 0x1cd8 0x1d0c 0x1d2e 0x1d48 0x1d60 0x1d7c 0x1d98 0x1db4 0x1dd0 0x1df4 0x1e1a 0x1e4a 0x1e88 0x1ed4 0x1f40 0x2008 0x206c 0x20bc>;
				design_capacity = <0xaf0>;
				design_qmax = <0xb54>;
				bat_res = <0x78>;
				max_input_current = <0x7d0>;
				max_chrg_current = <0x708>;
				max_chrg_voltage = <0x20d0>;
				sleep_enter_current = <0x12c>;
				sleep_exit_current = <0x12c>;
				power_off_thresd = <0x1770>;
				zero_algorithm_vol = <0x17d4>;
				max_soc_offset = <0x06>;
				monitor_sec = <0x05>;
				sample_res = <0x0a>;
				bat_res_up = <0x8c>;
				bat_res_down = <0x14>;
				virtual_power = <0x00>;
				register_chg_psy = <0x01>;
			};

			rk809_codec: codec {
				#sound-dai-cells = <0x01>;
				compatible = "rockchip,rk809-codec", "rockchip,rk817-codec";
				clocks = <0x02 0x15>;
				clock-names = "mclk";
				pinctrl-names = "default";
				pinctrl-0 = <0x6a>;
				pdmdata-out-enable;
				use-ext-amplifier;
				adc-for-loopback;
				spk-ctl-gpios = <0x6b 0x0a 0x00>; /* gpio3 RK_PB2 */
				pa-drv-gpios = <0x6b 0x00 0x00>; /* gpio3 RK_PA0 */
				hp-volume = <0x14>;
				spk-volume = <0x14>;
				phandle = <0xcb>;
			};
		};
	};

	i2c1: i2c@ff190000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xff190000 0x00 0x1000>;
		clocks = <0x02 0x1e 0x02 0x14f>;
		clock-names = "i2c", "pclk";
		interrupts = <0x00 0x08 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x6c>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0xfb>;

		ts@40 {
			compatible = "gslX680-d708";
			reg = <0x40>;
			touch-gpio = <0x60 0x0d 0x08>; /* gpio0 RK_PB5 */
			wake-gpio = <0x60 0x0c 0x08>; /* gpio0 RK_PB4 */
			screen_max_x = <0x400>;
			screen_max_y = <0x258>;
			revert_y = <0x00>;
			status = "okay";
		};
	};

	i2c2: i2c@ff1a0000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xff1a0000 0x00 0x1000>;
		clocks = <0x02 0x1f 0x02 0x150>;
		clock-names = "i2c", "pclk";
		interrupts = <0x00 0x09 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x6d>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0xfc>;

		gc5025: gc5025@37 {
			status = "okay";
			compatible = "galaxycore,gc5025";
			reg = <0x37>;
			pinctrl-names = "default";
			pinctrl-0 = <0x6e>;
			clocks = <0x02 0x34>;
			clock-names = "xvclk";
			avdd-supply = <0x6f>;
			dovdd-supply = <0x4c>;
			dvdd-supply = <0x70>;
			pwdn-gpios = <0x71 0x0e 0x00>; /* gpio2 RK_PB6 */
			rockchip,camera-module-index = <0x00>;
			rockchip,camera-module-facing = "front";
			rockchip,camera-module-name = "CameraKing";
			rockchip,camera-module-lens-name = "Largan";
			phandle = <0xfd>;

			port {

				gc5025_out: endpoint {
					remote-endpoint = <0x72>;
					data-lanes = <0x01 0x02>;
					phandle = <0x93>;
				};
			};
		};
	};

	i2c3: i2c@ff1b0000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xff1b0000 0x00 0x1000>;
		clocks = <0x02 0x20 0x02 0x151>;
		clock-names = "i2c", "pclk";
		interrupts = <0x00 0x0a 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x73>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0xfe>;
	};

	spi0: spi@ff1d0000 {
		compatible = "rockchip,px30-spi", "rockchip,rk3066-spi";
		reg = <0x00 0xff1d0000 0x00 0x1000>;
		interrupts = <0x00 0x1a 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x02 0x24 0x02 0x155>;
		clock-names = "spiclk", "apb_pclk";
		dmas = <0x2c 0x0c 0x2c 0x0d>;
		dma-names = "tx", "rx";
		pinctrl-names = "default", "high_speed";
		pinctrl-0 = <0x74 0x75 0x76 0x77>;
		pinctrl-1 = <0x78 0x75 0x79 0x7a>;
		status = "disabled";
		phandle = <0xff>;
	};

	spi1: spi@ff1d8000 {
		compatible = "rockchip,px30-spi", "rockchip,rk3066-spi";
		reg = <0x00 0xff1d8000 0x00 0x1000>;
		interrupts = <0x00 0x1b 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x02 0x25 0x02 0x156>;
		clock-names = "spiclk", "apb_pclk";
		dmas = <0x2c 0x0e 0x2c 0x0f>;
		dma-names = "tx", "rx";
		pinctrl-names = "default", "high_speed";
		pinctrl-0 = <0x7b 0x7c 0x7d 0x7e 0x7f>;
		pinctrl-1 = <0x80 0x7c 0x7d 0x81 0x82>;
		status = "disabled";
		phandle = <0x100>;
	};

	wdt: watchdog@ff1e0000 {
		compatible = "snps,dw-wdt";
		reg = <0x00 0xff1e0000 0x00 0x100>;
		clocks = <0x02 0x15b>;
		interrupts = <0x00 0x25 0x04>;
		resets = <0x02 0xb5>;
		reset-names = "reset";
		status = "disabled";
		phandle = <0x101>;
	};

	pwm0: pwm@ff200000 {
		compatible = "rockchip,px30-pwm", "rockchip,rk3328-pwm";
		reg = <0x00 0xff200000 0x00 0x10>;
